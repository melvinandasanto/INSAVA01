  <!-- Copia automática de pdfium.dll nativo desde la carpeta packages al bin (solo para builds x64) -->
  <Target Name="CopyPdfiumNative" AfterTargets="Build" Condition="'$(Platform)'=='x64'">
    <ItemGroup>
      <!-- Busca pdfium.dll en cualquier paquete PdfiumViewer.Native.* dentro de packages -->
      <PdfiumFiles Include="$(MSBuildProjectDirectory)\..\packages\PdfiumViewer.Native.*\**\pdfium.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PdfiumFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
	  <!-- Copiar carpeta BasedeDatos y ManualDeUsuario al directorio de salida -->
	  <ItemGroup>
		  <Content Include="BasedeDatos\**\*">
			  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		  </Content>
		  <Content Include="ManualDeUsuario\**\*">
			  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		  </Content>
	  </ItemGroup>
  </Target>